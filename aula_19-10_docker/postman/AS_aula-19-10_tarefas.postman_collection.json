    {
      "name": "GET /saude (api_mysql)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/saude",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "saude"
          ]
        },
        "description": "Somente na api_mysql."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('api e banco ok', () => { const j = pm.response.json(); pm.expect(j.api).to.eql('ok'); pm.expect(j.banco).to.eql('ok'); });"
            ]
          }
        }
      ]
